<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">




<gazebo reference="${prefix}lidar_link">
    <sensor name="rplidar" type="gpu_lidar">
        <pose>0 0 0.0105 0 0 0</pose>

        <topic>scan</topic>
        <update_rate>10</update_rate>

        <lidar>
            <scan>
                <horizontal>
                <samples>10</samples>
                <resolution>0.225</resolution>
                <min_angle>-3.12413907051086</min_angle>
                <max_angle>3.14159274101257</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.02</min>
                <max>14.0</max>
                <resolution>0.0012</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.001</stddev>
            </noise>
        </lidar>

        <always_on>1</always_on>
        <visualize>1</visualize>
    </sensor>
    
</gazebo>
</robot>

    

