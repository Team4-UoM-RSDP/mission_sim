<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="lidar_sensor" params="parent prefix *origin mount_mesh_scale:=1.0">

    <gazebo reference="lidar_link">
      <sensor name="rp_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>leo1/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
      
        

        <ray>
          <scan>
            <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.12413907051086</min_angle>
            <max_angle>3.14159274101257</max_angle>
            </horizontal>
            <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.000001</min>
            <max>12.0</max>
            <resolution>0.0012</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </ray>

        
      </sensor>
    
    </gazebo>
  </xacro:macro>
</robot>  